+bool32 RSDK::InitRetroEngine(int32 argc, char *argv[])
+{
+    if (s_libretroEngineReady)
+        DeinitRetroEngine();
+
+    ParseArguments(argc, argv);
+    RenderDevice::isRunning = false;
+    if (!InitStorage()) {
+        ReleaseStorage();
+        return false;
+    }
+
+    SKU::InitUserCore();
+    if (!SKU::userCore) {
+        ReleaseStorage();
+        return false;
+    }
+    LoadSettingsINI();
+    SKU::curSKU.platform = SKU::userCore->GetUserPlatform();
+    if (!SKU::userCore->CheckAPIInitialized()) {
+        SKU::ReleaseUserCore();
+        ReleaseStorage();
+        return false;
+    }
+
+#if RETRO_REV0U
+    DetectEngineVersion();
+#endif
+    InitEngine();
+    if (!RenderDevice::Init()) {
+        RenderDevice::Release(false);
+        SKU::ReleaseUserCore();
+        ReleaseStorage();
+        Link::Close(gameLogicHandle);
+        gameLogicHandle = NULL;
+        return false;
+    }
+    RenderDevice::isRunning = true;
+    currentScreen = &screens[0];
+    videoSettings.screenCount = 1;
+    RenderDevice::InitFPSCap();
+    s_libretroEngineReady = true;
+    return true;
+}
+
+void RSDK::StepRetroEngine()
+{
+    if (!s_libretroEngineReady || !RenderDevice::isRunning)
+        return;
+    AudioDevice::FrameInit();
+#if RETRO_REV02
+    SKU::userCore->FrameInit();
+    if (SKU::userCore->CheckEnginePause())
+        return;
+#endif
+    if (!engine.hardPause) {
+        foreachStackPtr = foreachStackList;
+#if !RETRO_USE_ORIGINAL_CODE
+        debugHitboxCount = 0;
+#endif
+        ProcessInputDevices();
+        if (engine.devMenu)
+            ProcessDebugCommands();
+#if RETRO_REV0U
+        switch (engine.version) {
+            default:
+            case 5: ProcessEngine(); break;
+            case 4: Legacy::v4::ProcessEngine(); break;
+            case 3: Legacy::v3::ProcessEngine(); break;
+        }
+#else
+        ProcessEngine();
+#endif
+        if (videoSettings.windowState == WINDOWSTATE_ACTIVE)
+            RenderDevice::CopyFrameBuffer();
+    }
+    if (videoSettings.windowState == WINDOWSTATE_ACTIVE) {
+        RenderDevice::ProcessDimming();
+        RenderDevice::FlipScreen();
+    }
+}
+
+void RSDK::DeinitRetroEngine()
+{
+    if (!s_libretroEngineReady)
+        return;
+    s_libretroEngineReady = false;
+    ReleaseInputDevices();
+    RenderDevice::Release(false);
+    SaveSettingsINI(false);
+    SKU::ReleaseUserCore();
+    ReleaseStorage();
+#if RETRO_USE_MOD_LOADER
+    UnloadMods();
+#endif
+    Link::Close(gameLogicHandle);
+    gameLogicHandle = NULL;
+}
